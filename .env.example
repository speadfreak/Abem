# ─────────────────────────────────────────────────────────────
# ABEM RESTAURANT — environment template
# Copy to .env (local) or paste into Vercel → Project → Settings
# → Environment Variables. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# Neon Postgres — pooled connection string (application runtime)
# Neon Console → your project → "Pooled connection"
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Postgres — DIRECT (unpooled) connection, used by Prisma for
# migrations / db push (Prisma requires directUrl when the pooled
# endpoint sits behind PgBouncer)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Session signing secret for admin auth (generate: openssl rand -hex 32)
SESSION_SECRET="replace-with-64-char-random-hex"

# Public site URL (used for metadata, sitemap, QR codes)
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"

# Optional: where contact-form notifications are emailed (console in dev)
CONTACT_INBOX="hello@abemrestaurant.et"

# ─── Payment adapters (all optional — COD works without them) ───
# TELEBIRR_APP_ID=""
# TELEBIRR_PUBLIC_KEY=""
# CHAPA_SECRET_KEY=""
# SANTIMPAY_CLIENT_ID=""
# SANTIMPAY_SECRET=""

# ─── Notification adapters (optional — console adapter is default) ───
# AT_API_KEY=""        # Africa's Talking (SMS for Ethiopia)
# AT_USERNAME=""
# RESEND_API_KEY=""    # transactional email
